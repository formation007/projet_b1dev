* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #222;
  background-color: #f4f6f8;
}

header,
main,
footer {
  width: min(90%, 800px);
  margin: auto;
}

header {
  padding: 40px 0 20px;
  text-align: center;
}

h1 {
  margin-bottom: 10px;
  color: #2563eb;
}

main {
  padding: 30px;
  background-color: white;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgb(0 0 0 / 10%);
}

h2 {
  margin-top: 0;
}

ul {
  padding-left: 20px;
}

a {
  color: #2563eb;
  text-decoration: none;
}

a:hover,
a:focus {
  text-decoration: underline;
}

footer {
  padding: 20px 0;
  text-align: center;
  color: #666;
  font-size: 0.9rem;
}